{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://astraos.dev/protocols/spatial/spatial-state-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "state", "input_source", "camera_status", "frame_id", "frame_timestamp", "surface_candidates", "selected_target_id", "scene_id", "quality", "observer_tracking", "processing_duration_ms", "coordinate_system", "warnings"],
  "properties": {"schema_version": {"const": "1.0"}, "state": {"enum": ["STOPPED", "STARTING", "READY", "CAPTURING", "DETECTING", "TRACKING", "DEGRADED", "LOST", "STOPPING", "ERROR"]}, "input_source": {"enum": ["CAMERA", "IMAGE", "VIDEO", "SIMULATION"]}, "camera_status": {"enum": ["UNAVAILABLE", "PERMISSION_REQUIRED", "DENIED", "INACTIVE", "ACTIVE", "DISCONNECTED"]}, "frame_id": {"type": ["string", "null"], "format": "uuid"}, "frame_timestamp": {"type": ["string", "null"], "format": "date-time"}, "surface_candidates": {"type": "integer", "minimum": 0}, "selected_target_id": {"type": ["string", "null"], "format": "uuid"}, "scene_id": {"type": ["string", "null"], "format": "uuid"}, "quality": {"enum": ["EXCELLENT", "GOOD", "FAIR", "POOR", "UNUSABLE"]}, "observer_tracking": {"enum": ["SIMULATED", "UNAVAILABLE"]}, "processing_duration_ms": {"type": "number", "minimum": 0}, "coordinate_system": {"const": "WORLD_SIMULATED"}, "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 500}}}
}
