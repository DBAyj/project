{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://astraos.dev/protocols/spatial/spatial-frame-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "frame_id", "source", "width", "height", "pixel_format", "coordinate_system", "timestamp"],
  "properties": {"schema_version": {"const": "1.0"}, "frame_id": {"type": "string", "format": "uuid"}, "source": {"enum": ["CAMERA", "IMAGE", "VIDEO", "SIMULATION"]}, "width": {"type": "integer", "minimum": 1, "maximum": 7680}, "height": {"type": "integer", "minimum": 1, "maximum": 4320}, "pixel_format": {"enum": ["BGR8", "RGB8", "GRAY8"]}, "coordinate_system": {"const": "IMAGE_PIXEL"}, "timestamp": {"type": "string", "format": "date-time"}}
}
