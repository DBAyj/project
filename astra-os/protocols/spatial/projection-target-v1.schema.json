{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://astraos.dev/protocols/spatial/projection-target-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "target_id", "surface_id", "surface_type", "source_resolution", "target_resolution", "corners", "coordinate_system", "target_coordinate_system", "homography", "inverse_homography", "quality", "privacy_level", "state", "selected", "created_at", "updated_at"],
  "properties": {"schema_version": {"const": "1.0"}, "target_id": {"type": "string", "format": "uuid"}, "surface_id": {"type": "string", "format": "uuid"}, "surface_type": {"enum": ["DESK", "WALL", "SCREEN", "UNKNOWN"]}, "source_resolution": {"$ref": "#/$defs/resolution"}, "target_resolution": {"$ref": "#/$defs/resolution"}, "corners": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point"}}, "coordinate_system": {"const": "IMAGE_PIXEL"}, "target_coordinate_system": {"const": "SURFACE_LOCAL"}, "homography": {"$ref": "#/$defs/matrix3"}, "inverse_homography": {"$ref": "#/$defs/matrix3"}, "quality": {"enum": ["EXCELLENT", "GOOD", "FAIR", "POOR", "UNUSABLE"]}, "privacy_level": {"enum": ["PUBLIC", "ROOM_ONLY", "AUTHORIZED_PERSON", "PRIVATE_SCREEN_ONLY", "NO_PROJECTION"]}, "state": {"enum": ["CANDIDATE", "SELECTED", "CALIBRATED", "ACTIVE", "DEGRADED", "LOST", "INVALID"]}, "selected": {"type": "boolean"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}},
  "$defs": {"resolution": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}, "point": {"type": "object", "additionalProperties": false, "required": ["x", "y", "coordinate_system"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "coordinate_system": {"const": "IMAGE_PIXEL"}}}, "matrix3": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number"}}}
}
