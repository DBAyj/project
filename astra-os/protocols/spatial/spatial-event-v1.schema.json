{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://astraos.dev/protocols/spatial/spatial-event-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_id", "timestamp", "service", "event", "trace_id", "request_id", "state", "result", "error_code", "coordinate_system", "details"],
  "properties": {"schema_version": {"const": "1.0"}, "event_id": {"type": "string", "format": "uuid"}, "timestamp": {"type": "string", "format": "date-time"}, "service": {"const": "astra-spatial-service"}, "event": {"enum": ["spatial_service_started", "spatial_service_stopped", "camera_permission_requested", "camera_permission_granted", "camera_permission_denied", "camera_started", "camera_stopped", "camera_disconnected", "input_source_changed", "frame_processing_started", "frame_processing_failed", "surface_candidate_detected", "surface_selected", "surface_rejected", "calibration_started", "calibration_point_added", "calibration_confirmed", "calibration_failed", "projection_target_created", "projection_target_lost", "scene_created", "scene_state_changed", "observer_position_changed", "spatial_fallback_enabled", "spatial_safe_pause", "debug_frame_saved"]}, "trace_id": {"type": "string", "format": "uuid"}, "request_id": {"type": "string", "format": "uuid"}, "state": {"enum": ["STOPPED", "STARTING", "READY", "CAPTURING", "DETECTING", "TRACKING", "DEGRADED", "LOST", "STOPPING", "ERROR"]}, "result": {"enum": ["success", "rejected", "error"]}, "error_code": {"type": ["integer", "null"], "minimum": 3001, "maximum": 9999}, "coordinate_system": {"enum": ["IMAGE_PIXEL", "IMAGE_NORMALIZED", "PHONE_VIEW", "PROJECTION_VIEW", "SURFACE_LOCAL", "WORLD_SIMULATED"]}, "details": {"type": "object"}}
}
