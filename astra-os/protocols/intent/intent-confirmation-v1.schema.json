{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraos.dev/protocols/intent/intent-confirmation-v1.schema.json",
  "title": "AstraOS Intent Confirmation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "confirmation_id", "request_id", "action", "message", "status", "created_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "confirmation_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "action": {"type": "string", "minLength": 1, "maxLength": 128},
    "message": {"type": "string", "minLength": 1, "maxLength": 500},
    "status": {"type": "string", "enum": ["PENDING", "ACCEPTED", "REJECTED", "EXPIRED"]},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}
  }
}
