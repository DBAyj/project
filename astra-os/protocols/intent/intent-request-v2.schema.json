{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraos.dev/protocols/intent/intent-request-v2.schema.json",
  "title": "AstraOS Intent Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "session_id", "user_id", "locale", "raw_text", "current_context", "client", "requested_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "locale": {"type": "string", "enum": ["zh-CN", "en-US"]},
    "raw_text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "current_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_state", "current_space", "current_privacy_level", "current_model_id"],
      "properties": {
        "projection_state": {"type": "string", "enum": ["IDLE", "STARTING", "ACTIVE", "PAUSED", "STOPPING", "DENIED", "ERROR"]},
        "current_space": {"type": "string", "minLength": 1, "maxLength": 128},
        "current_privacy_level": {"type": "string", "enum": ["PUBLIC", "ROOM_ONLY", "AUTHORIZED_PERSON", "PRIVATE_SCREEN_ONLY", "NO_PROJECTION"]},
        "current_model_id": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}
      }
    },
    "requested_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}
  }
}
