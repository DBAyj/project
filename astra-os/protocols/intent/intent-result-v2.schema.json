{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraos.dev/protocols/intent/intent-result-v2.schema.json",
  "title": "AstraOS Intent Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "trace_id", "intent", "confidence", "execution_policy", "requires_confirmation", "ambiguous", "candidates", "slots", "normalized_text", "processing", "warnings", "error", "clarification", "confirmation", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "trace_id": {"type": "string", "format": "uuid"},
    "intent": {"$ref": "#/$defs/intent"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "execution_policy": {"type": "string", "enum": ["AUTO_EXECUTE", "REQUIRE_CONFIRMATION", "ASK_CLARIFICATION", "REJECT"]},
    "requires_confirmation": {"type": "boolean"},
    "ambiguous": {"type": "boolean"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}, "maxItems": 16},
    "slots": {"$ref": "#/$defs/slots"},
    "normalized_text": {"type": "string", "maxLength": 2000},
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_engine_used", "local_model_used", "fallback_used", "cache_hit", "duration_ms"],
      "properties": {
        "rule_engine_used": {"type": "boolean"},
        "local_model_used": {"type": "boolean"},
        "fallback_used": {"type": "boolean"},
        "cache_hit": {"type": "boolean"},
        "duration_ms": {"type": "number", "minimum": 0}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 500}, "maxItems": 32},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "integer", "minimum": 1000, "maximum": 9999}, "message": {"type": "string", "minLength": 1, "maxLength": 500}}}
      ]
    },
    "clarification": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["question", "options"], "properties": {"question": {"type": "string", "minLength": 1, "maxLength": 500}, "options": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "minItems": 1, "maxItems": 8}}}
      ]
    },
    "confirmation": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["confirmation_id", "message", "expires_at"], "properties": {"confirmation_id": {"type": "string", "format": "uuid"}, "message": {"type": "string", "minLength": 1, "maxLength": 500}, "expires_at": {"type": "string", "format": "date-time"}}}
      ]
    },
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}
  },
  "$defs": {
    "intent": {
      "type": "string",
      "enum": ["project_3d_model", "start_projection", "stop_projection", "pause_projection", "resume_projection", "reset_projection_view", "enter_projection_fullscreen", "exit_projection_fullscreen", "rotate_model", "zoom_in_model", "zoom_out_model", "reset_model", "switch_model", "show_model_details", "show_phone_display", "show_projection_display", "hide_projection_content", "show_system_status", "show_projection_status", "set_privacy_public", "set_privacy_room_only", "set_privacy_authorized_person", "set_privacy_private_screen_only", "set_privacy_no_projection", "help", "cancel", "confirm", "reject", "repeat_last_action", "unknown"]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "confidence", "source"],
      "properties": {
        "intent": {"$ref": "#/$defs/intent"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source": {"type": "string", "enum": ["RULE_ENGINE", "LOCAL_MODEL", "FALLBACK"]},
        "rule_id": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 16}
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_space", "model_id", "privacy_level", "zoom_factor", "rotation_direction", "rotation_degrees", "display_target", "confirmation_response"],
      "properties": {
        "target_space": {"type": ["string", "null"], "enum": ["desk", "wall", "projection_screen", "phone_screen", "current_space", null]},
        "model_id": {"type": ["string", "null"], "maxLength": 128},
        "privacy_level": {"type": ["string", "null"], "enum": ["PUBLIC", "ROOM_ONLY", "AUTHORIZED_PERSON", "PRIVATE_SCREEN_ONLY", "NO_PROJECTION", null]},
        "zoom_factor": {"type": ["number", "null"], "minimum": 0.1, "maximum": 10},
        "rotation_direction": {"type": ["string", "null"], "enum": ["left", "right", "clockwise", "counterclockwise", null]},
        "rotation_degrees": {"type": ["number", "null"], "minimum": -360, "maximum": 360},
        "display_target": {"type": ["string", "null"], "enum": ["phone_screen", "projection_screen", null]},
        "confirmation_response": {"type": ["string", "null"], "enum": ["confirm", "reject", null]}
      }
    }
  }
}
