{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraos.dev/schemas/privacy-policy.schema.json",
  "title": "AstraOS privacy policy decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "privacy_level", "projection_allowed", "reason"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "privacy_level": {"type": "string", "enum": ["PUBLIC", "ROOM_ONLY", "AUTHORIZED_PERSON", "PRIVATE_SCREEN_ONLY", "NO_PROJECTION"]},
    "projection_allowed": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1}
  }
}
