{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraos.dev/schemas/surface-detection-config.schema.json",
  "type": "object", "additionalProperties": false, "required": ["preprocessing", "detection", "candidate_scoring"],
  "properties": {
    "preprocessing": {"type": "object", "additionalProperties": false, "required": ["target_width", "target_height", "grayscale", "gaussian_blur_kernel", "edge_detector", "canny_low_threshold", "canny_high_threshold"], "properties": {"target_width": {"type": "integer", "minimum": 160, "maximum": 7680}, "target_height": {"type": "integer", "minimum": 120, "maximum": 4320}, "grayscale": {"const": true}, "gaussian_blur_kernel": {"type": "integer", "minimum": 1, "maximum": 31}, "edge_detector": {"const": "canny"}, "canny_low_threshold": {"type": "number", "minimum": 0, "maximum": 1000}, "canny_high_threshold": {"type": "number", "minimum": 0, "maximum": 1000}}},
    "detection": {"type": "object", "additionalProperties": false, "required": ["minimum_area_ratio", "maximum_area_ratio", "minimum_aspect_ratio", "maximum_aspect_ratio", "polygon_epsilon_ratio", "require_convex", "border_margin_pixels"], "properties": {"minimum_area_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "maximum_area_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "minimum_aspect_ratio": {"type": "number", "exclusiveMinimum": 0}, "maximum_aspect_ratio": {"type": "number", "exclusiveMinimum": 0}, "polygon_epsilon_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.2}, "require_convex": {"type": "boolean"}, "border_margin_pixels": {"type": "integer", "minimum": 0, "maximum": 1000}}},
    "candidate_scoring": {"type": "object", "additionalProperties": false, "required": ["geometry_weight", "area_weight", "stability_weight", "position_weight", "type_weight", "border_penalty", "occlusion_penalty"], "properties": {"geometry_weight": {"type": "number", "minimum": 0, "maximum": 1}, "area_weight": {"type": "number", "minimum": 0, "maximum": 1}, "stability_weight": {"type": "number", "minimum": 0, "maximum": 1}, "position_weight": {"type": "number", "minimum": 0, "maximum": 1}, "type_weight": {"type": "number", "minimum": 0, "maximum": 1}, "border_penalty": {"type": "number", "minimum": 0, "maximum": 1}, "occlusion_penalty": {"type": "number", "minimum": 0, "maximum": 1}}}
  }
}
