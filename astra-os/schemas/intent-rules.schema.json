{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraos.dev/schemas/intent-rules.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "example_generation", "rules"],
  "properties": {
    "version": {"const": "1.0"},
    "example_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_zh_templates", "positive_en_templates", "ambiguous_templates", "negative_templates"],
      "properties": {
        "positive_zh_templates": {"type": "array", "minItems": 10, "items": {"type": "string", "pattern": "\\{phrase\\}"}, "uniqueItems": true},
        "positive_en_templates": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "\\{phrase\\}"}, "uniqueItems": true},
        "ambiguous_templates": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "\\{phrase\\}"}, "uniqueItems": true},
        "negative_templates": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "\\{phrase\\}"}, "uniqueItems": true}
      }
    },
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "priority", "locales", "enabled", "confidence", "exact_phrases"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "intent": {"type": "string", "enum": ["project_3d_model", "start_projection", "stop_projection", "pause_projection", "resume_projection", "reset_projection_view", "enter_projection_fullscreen", "exit_projection_fullscreen", "rotate_model", "zoom_in_model", "zoom_out_model", "reset_model", "switch_model", "show_model_details", "show_phone_display", "show_projection_display", "hide_projection_content", "show_system_status", "show_projection_status", "set_privacy_public", "set_privacy_room_only", "set_privacy_authorized_person", "set_privacy_private_screen_only", "set_privacy_no_projection", "help", "cancel", "confirm", "reject", "repeat_last_action", "unknown"]},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "locales": {"type": "array", "items": {"enum": ["zh-CN", "en-US"]}, "minItems": 1, "uniqueItems": true},
        "enabled": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "exact_phrases": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "uniqueItems": true},
        "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "templates": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "synonyms": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}},
        "negation_terms": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "required_slots": {"type": "array", "items": {"enum": ["target_space", "model_id", "privacy_level", "zoom_factor", "rotation_direction", "rotation_degrees", "display_target", "confirmation_response"]}, "uniqueItems": true},
        "default_slots": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
