{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "state", "frame_id", "accepted_layer_count", "privacy_mask_final"],
  "properties": {
    "session_id": {"type": "string", "format": "uuid"},
    "state": {"const": "RENDERING"},
    "frame_id": {"type": "integer", "minimum": 1},
    "accepted_layer_count": {"type": "integer", "minimum": 1, "maximum": 500},
    "privacy_mask_final": {"const": true}
  }
}
