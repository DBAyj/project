{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["component_id", "component_type", "privacy_level", "accessibility_label", "bounds", "display_target"],
  "properties": {
    "component_id": {"type": "string", "format": "uuid"},
    "component_type": {"enum": ["SPATIAL_WINDOW", "TASK_CARD", "SYSTEM_PANEL", "NOTIFICATION", "BUTTON", "TOGGLE", "SLIDER", "LABEL", "IMAGE", "MODEL_VIEW", "PRIVACY_BADGE", "CONTEXT_MENU", "DEBUG_PANEL"]},
    "parent_id": {"type": ["string", "null"], "format": "uuid"},
    "children": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "privacy_level": {"enum": ["PUBLIC", "ROOM_ONLY", "AUTHORIZED_PERSON", "PRIVATE_SCREEN_ONLY", "NO_PROJECTION"]},
    "accessibility_label": {"type": "string", "minLength": 1, "maxLength": 256},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "display_target": {"enum": ["PHONE", "PROJECTION", "BOTH"]}
  }
}
