.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 20rpx;
  background:
    linear-gradient(180deg, rgba(36, 39, 42, 0.95), rgba(17, 19, 24, 1) 42%),
    #111318;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.title-block {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.eyebrow {
  color: #9aa5a6;
  font-size: 22rpx;
}

.title {
  color: #f7f7f2;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 156rpx;
  justify-content: center;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(247, 247, 242, 0.14);
  border-radius: 8rpx;
  background: rgba(247, 247, 242, 0.06);
  color: #d9ddd5;
  font-size: 24rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff6b4a;
}

.status-online .status-dot {
  background: #4bd37b;
}

.arena-shell {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 56.25%;
  overflow: hidden;
  border: 2rpx solid rgba(247, 247, 242, 0.16);
  border-radius: 8rpx;
  background: #171a20;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.28);
}

.arena-canvas {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.score-strip {
  display: flex;
  gap: 10rpx;
  min-height: 76rpx;
  margin: 14rpx 0 18rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.score-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-width: 174rpx;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 14rpx;
  border: 1rpx solid rgba(247, 247, 242, 0.12);
  border-radius: 8rpx;
  background: rgba(247, 247, 242, 0.06);
}

.score-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.score-name {
  max-width: 88rpx;
  overflow: hidden;
  color: #f7f7f2;
  font-size: 24rpx;
  text-overflow: ellipsis;
}

.score-hp {
  color: #4bd37b;
  font-size: 22rpx;
}

.score-num {
  margin-left: auto;
  color: #ffd166;
  font-size: 28rpx;
  font-weight: 700;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.mode-row,
.online-row {
  display: flex;
  gap: 12rpx;
}

button {
  flex: 1;
  height: 76rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #252a31;
  color: #f7f7f2;
  font-size: 26rpx;
  line-height: 76rpx;
}

button::after {
  border: 0;
}

.primary {
  background: #00a6a6;
}

.accent {
  background: #ff6b4a;
}

.ghost {
  flex: 0 0 144rpx;
  background: #3a3e43;
}

input {
  flex: 1;
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid rgba(247, 247, 242, 0.14);
  border-radius: 8rpx;
  background: rgba(247, 247, 242, 0.08);
  color: #f7f7f2;
  font-size: 26rpx;
}

.server-input {
  min-width: 0;
}

.hint {
  margin-top: 18rpx;
  color: #aeb7b8;
  font-size: 24rpx;
  line-height: 1.45;
}
